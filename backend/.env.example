# Adaptive RAG — copy to .env and fill in. NEVER commit a real .env.
# The app runs with everything below empty (degraded/demo mode:
# in-memory retrieval + extractive answers), but for real LLM answers
# set at least GEMINI_API_KEY (free tier, Google AI Studio).

# --- LLM: Gemini is the DEFAULT provider (free tier) -------------------
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Optional second key (different Google AI Studio project): the app
# switches to it automatically when the primary key hits its quota.
GEMINI_API_KEY_SECONDARY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Embeddings ---------------------------------------------------------
# EMBEDDING_PROVIDER: gemini | local | hash | auto (default auto:
# gemini when GEMINI_API_KEY is set, else local sentence-transformers)
EMBEDDING_PROVIDER=auto
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIM: leave empty for the provider default (768 Gemini, 384 local/hash).
# If you set it, the Qdrant collection is created with exactly this size.
# EMBEDDING_DIM=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- LLM fallback: Ollama-compatible OpenAI-style endpoint -------------
# Used only when GEMINI_API_KEY is empty.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=llama3.1
OPENAI_API_KEY=

# --- Vector store (Qdrant) ----------------------------------------------
# If Qdrant is unreachable the app falls back to an in-memory store.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=adaptive_rag

# --- Auth (email + password login, JWT) -----------------------------------
# JWT_SECRET signs the access tokens. REQUIRED in production — the
# server refuses to start without it. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# and set it in the environment (Render: dashboard > Environment).
# Local dev: put it in backend/.env (gitignored, never committed).
# The same value must be used by every backend instance (web + worker
# share the container here, so one variable covers both).
JWT_SECRET=

# --- Database ------------------------------------------------------------
# SQLite by default; Neon Postgres also works, e.g.:
# DATABASE_URL=postgresql+asyncpg://user:password@host/dbname
DATABASE_URL=sqlite+aiosqlite:///./adaptive_rag.db

# --- Tracing (both optional) ---------------------------------------------
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=adaptive-rag
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Response cache (Redis) ----------------------------------------------
# Exact-match + semantic response cache (see app/cache.py). If Redis is
# unreachable the app falls back to a bounded in-process cache.
REDIS_URL=redis://localhost:6379
# CACHE_TTL_SECONDS: cached answers live 24h by default.
CACHE_TTL_SECONDS=86400
# CACHE_SEMANTIC_THRESHOLD: cosine similarity for a paraphrase to hit.
CACHE_SEMANTIC_THRESHOLD=0.95
# CACHE_MAX_ENTRIES: bound for the in-process fallback cache.
CACHE_MAX_ENTRIES=200

# --- Retrieval behaviour --------------------------------------------------
TOP_K=5
MAX_RETRIES=2
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- Conversational history + prompt token budget -----------------------
# MAX_CONTEXT_TOKENS caps the assembled generation prompt (chars/4
# estimate): oldest history turns drop first, then lowest-graded chunks.
# MAX_OUTPUT_TOKENS caps each generation call. MAX_HISTORY_TURNS = prior
# turns (user+assistant pairs) sent with each question for follow-ups.
MAX_CONTEXT_TOKENS=8000
MAX_OUTPUT_TOKENS=1024
MAX_HISTORY_TURNS=3

# Routing: set USE_LLM_ROUTING=true only if you want the LLM to classify
# ambiguous questions (costs 1 generate call/question against free-tier quota).
# Default false — the heuristic router already sends real questions to retrieval.
# USE_LLM_ROUTING=false

# --- Web search fallback (Tavily) -----------------------------------------
# Optional: when local documents cannot answer a question, the system
# searches the web (Tavily) and answers from those results, with web
# citations. Free Researcher plan: 1,000 credits/month (basic search =
# 1 credit, advanced = 2). Get a key at https://tavily.com — leave
# empty to disable the fallback entirely.
TAVILY_API_KEY=
# TAVILY_ENABLED: master switch for the fallback (default true when a key is set).
# TAVILY_ENABLED=true
# TAVILY_SEARCH_DEPTH: basic (1 credit) or advanced (2 credits, wider).
# TAVILY_SEARCH_DEPTH=basic
# TAVILY_MAX_RESULTS: web results fetched per fallback (default 5).
# TAVILY_MAX_RESULTS=5

# --- Guardrails -----------------------------------------------------------
# All three layers (input topic block, output PII redaction, role-based
# document access) are ON by default; set GUARDRAILS_ENABLED=false for a
# local demo without them. Blocked topics are category names
# (compensation, personal_data, credentials) plus extra literal phrases.
# PII types select the output scanner's entity set. PII detection uses
# Microsoft Presidio (pip install presidio-analyzer + spacy model
# en_core_web_sm) with custom PAN/Aadhaar/Indian-phone/API-key
# recognizers, and falls back to regex when Presidio is unavailable.
# GUARDRAILS_ENABLED=true
# GUARDRAIL_DEFAULT_ROLE=employee
# GUARDRAIL_BLOCKED_TOPICS=compensation,personal_data,credentials
# GUARDRAIL_BLOCKED_PHRASES=
# GUARDRAIL_PII_TYPES=email,phone,pan,aadhaar,api_key,credit_card
# GUARDRAIL_STREAM_SCAN=true
# Roles that may ask about the compensation / personal_data topics
# (still role-filtered at retrieval — they only ever see documents
# their role may access). Credentials are blocked for every role.
# GUARDRAIL_PRIVILEGED_ROLES=exec,hr
