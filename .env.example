# Adaptive RAG — environment variables
# Copy this file to backend/.env for local runs, or to .env at the repo root
# for `docker compose up`. Never commit a real .env file (see .gitignore).
#
# FREE-TIER DEFAULT: Google Gemini (Google AI Studio). The only key you
# need to run the full system is GEMINI_API_KEY. Everything else below
# is optional. With no key at all, the system still runs in degraded/demo
# mode: retrieval + grading work, and generation falls back to extractive
# passages from the retrieved chunks (and the UI says so).

# --- Gemini (DEFAULT LLM + embeddings, free tier) ---------------------------
# Get a free key: https://aistudio.google.com — sign in with a Google
# account, click "Get API key", create a key, and paste it here.
# Free-tier limits apply (rate limits / daily quotas — see AI Studio);
# the key is personal, so do not share it or commit it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_PROVIDER=gemini

# --- Vector database ---------------------------------------------------------
# Local (default, free): Qdrant via docker compose on http://localhost:6333.
# Optional free tier: Qdrant Cloud (free 1 GB cluster) — set QDRANT_URL to
# your cloud URL and QDRANT_API_KEY to its API key.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Metadata database -------------------------------------------------------
# Local default (free, no setup): SQLite file. Optional free tier: Neon
# Postgres — replace with your Neon connection string.
DATABASE_URL=sqlite+aiosqlite:///./adaptive_rag.db

# --- Fallback / alternative LLM ----------------------------------------------
# Ollama (free, local, no key): run `ollama pull llama3.1` and set
# LLM_BASE_URL to your Ollama server. Used only if Gemini is unavailable.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1

# OpenAI (optional, paid): only needed if you switch the provider to OpenAI.
OPENAI_API_KEY=

# --- Observability (all optional, free tiers) --------------------------------
# LangSmith (optional free tier): tracing + evaluation of LangGraph runs.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=adaptive-rag
# OpenTelemetry / Jaeger (free, local via docker compose):
# point the exporter at Jaeger; leave unset to disable OTel export.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Frontend ----------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
